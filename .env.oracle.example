# Free domain created in DuckDNS, without https:// or a final slash.
MARATON_DOMAIN=your-name.duckdns.org

# Copy the exact contents of data/.secret-key here.
# Do not generate a different value when migrating the existing database.
MARATON_SECRET_KEY=

# Optional SMTP for password recovery. Gmail uses smtp.gmail.com and port 465.
MARATON_SMTP_HOST=
MARATON_SMTP_PORT=465
MARATON_SMTP_USER=
MARATON_SMTP_PASSWORD=
MARATON_SMTP_FROM=
